(function(){
  const LS_KEY = "taxidiario-wakelock";

  let wakeLock = null;
  let activo = false;

  async function activar() {
    if (!("wakeLock" in navigator)) {
      console.warn("[WakeLock] No soportado");
      return false;
    }
    if (activo && wakeLock) return true;

    try {
      wakeLock = await navigator.wakeLock.request("screen");
      activo = true;

      wakeLock.addEventListener("release", () => {
        activo = false;
        wakeLock = null;
        console.log("[WakeLock] Liberado por el sistema");
      });

      console.log("[WakeLock] Activado ✅");
      return true;
    } catch (e) {
      console.warn("[WakeLock] Error:", e.message);
      activo = false;
      wakeLock = null;
      return false;
    }
  }

  async function desactivar() {
    if (wakeLock) {
      try { await wakeLock.release(); } catch (e) {}
    }
    wakeLock = null;
    activo = false;
    console.log("[WakeLock] Desactivado");
  }

  // Re-adquirir al volver a primer plano
  document.addEventListener("visibilitychange", async () => {
    if (document.visibilityState !== "visible") return;
    const queria = localStorage.getItem(LS_KEY) === "1";
    if (queria && !activo) {
      await activar();
    }
  });

  // API pública
  window.TaxiWakeLock = {
    activar: async () => {
      const ok = await activar();
      localStorage.setItem(LS_KEY, ok ? "1" : "0");
      return ok;
    },
    desactivar: async () => {
      await desactivar();
      localStorage.setItem(LS_KEY, "0");
    },
    estaActivo: () => activo,
    estaSoportado: () => "wakeLock" in navigator,
  };

  // Auto-activar si estaba activo
  if (localStorage.getItem(LS_KEY) === "1" && document.visibilityState === "visible") {
    activar();
  }
})();
